{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "bash": {
      "*": "ask",
      "dotnet build*": "allow",
      "dotnet test*": "allow",
      "dotnet format*": "allow",
      "dotnet restore*": "allow",
      "dotnet --version": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git blame*": "allow",
      "git show*": "allow",
      "openspec*": "allow"
    }
  }
}
