<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Projektlokal: nur nuget.org. Verhindert NU1507 (Central Package Management + mehrere Quellen). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
